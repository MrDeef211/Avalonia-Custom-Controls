<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Demonstrations.Desktop.App"
             xmlns:local="using:Demonstrations.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Common.Controls/TemplatedControls/AnimatedButtonBasic.axaml" /> 
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
</Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
         <StyleInclude Source="avares://Common.Controls/TemplatedControls/Toolbar.axaml" />
    </Application.Styles>
</Application>