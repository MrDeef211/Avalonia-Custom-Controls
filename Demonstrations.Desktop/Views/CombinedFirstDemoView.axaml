<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Common.Controls"
             xmlns:vm="using:Demonstrations.Desktop.ViewModels"             
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             x:Class="Demonstrations.Desktop.Views.CombinedFirstDemoView"
             x:DataType="vm:CombinedFirstDemoViewModel">
    <UserControl.Resources>
        <ControlTheme x:Key="KeyHint" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid ColumnDefinitions="140,*">
                            <Border Grid.Column="0" 
                                    Background="#44FFFFFF" 
                                    CornerRadius="4" 
                                    Padding="4,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" 
                                    FontSize="11" 
                                    FontWeight="SemiBold"
                                    FontFamily="Consolas" 
                                    Foreground="Gold"/>
                            </Border>
                            <TextBlock Grid.Column="1" 
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                   FontSize="11" 
                                   Foreground="#CCFFFFFF" 
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>
    <DockPanel>
        <controls:Toolbar DockPanel.Dock="Top" Background="#F0F0F0">
            <Button Command="{Binding GenerateCommand}" ToolTip.Tip="Новый случайный график">
                <PathIcon Data="M100,100 L300,100 L200,300Z" Width="16" Height="16" />
            </Button>
            <Separator Width="1" Height="20" Background="Gray" Margin="5,0"/>
            <TextBlock Text="X диапазон:" VerticalAlignment="Center" Margin="5,0,2,0"/>
            <controls:RangeSlider Minimum="-1000" Maximum="1000"
                                  LowerValue="{Binding LowerX}"
                                  UpperValue="{Binding UpperX}"
                                  Step="1"
                                  ShowTextBoxes="True"
                                  TextBoxWidth="60"
                                  Width="600"
                                  VerticalAlignment="Center"/>
            <Separator Width="1" Height="20" Background="Gray" Margin="5,0"/>
            <Button Command="{Binding ToggleOverlayCommand}" ToolTip.Tip="Показать/скрыть подсказку">
                <TextBlock Text="ℹ️" />
            </Button>
        </controls:Toolbar>

        <Grid>
            <controls:ZoomControl x:Name="ZoomCtrl"
                                   ZoomState="{Binding ZoomState}"
                                   Background="White"
                                   MinScale="1"
                                   MaxScale="20"
                                   RestrictPan="True">
                <controls:ChartControl Content="{Binding FullChartData}"
                                       Minimum="{Binding LowerX, Mode=TwoWay}"
                                       Maximum="{Binding UpperX, Mode=TwoWay}"
                                       SortedData="{Binding CurrentData}"
                                       ChartStyle="Spline"
                                       ChartColor="Red"
                                       ChartThickness="{Binding ChartThickness}"
                                       Fill="False"
                                       Background="WhiteSmoke"
                                       Grid="True"
                                       HighlightPoints="{Binding HighlightPoints}"
                                       ShowPointsLabels="{Binding ShowLabel}"
                                       Interactive="True"
                                       InteractiveModifier="Shift"/>
            </controls:ZoomControl>

            <Border Background="#AA000000" 
                    CornerRadius="8" 
                    Padding="12" 
                    Margin="20"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    IsVisible="{Binding ShowOverlay}">
                <StackPanel Spacing="5">
                    <TextBlock Text="Управление ZoomControl:" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="WASD / ←↑→↓" Content="Перемещение"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="Wheel / +/-" Content="Приближение"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="Double Click / Ctrl+0" Content="Сброс камеры"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="Ctrl+Z / Y" Content="История"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="Shift + Wheel" Content="Масштаб графика"/>
                    <HeaderedContentControl Theme="{StaticResource KeyHint}" Header="Shift + Mouse Move" Content="Перемещение по графику"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>