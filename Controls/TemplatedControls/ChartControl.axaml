<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Controls">
 
  <ControlTheme x:Key="{x:Type controls:ChartControl}" TargetType="controls:ChartControl">
    <Setter Property="Background" Value="Transparent"  />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="50, 30, 30, 50" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border 
          BorderBrush="Gray"
          BorderThickness="1"
          ClipToBounds="True">
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
