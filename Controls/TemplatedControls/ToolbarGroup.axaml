<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Controls">

<Style Selector="controls|ToolbarGroup">
    <Setter Property="Margin" Value="0,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
        <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <StackPanel Orientation="Vertical">
                
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Margin="0,0,0,0"/>

                <ContentPresenter Content="{TemplateBinding Header}"
                                  HorizontalAlignment="Center"
                                  FontSize="11"
                                  Foreground="#666666" />
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Setter>
</Style>

<Style Selector="controls|ToolbarGroup Button, controls|ToolbarGroup ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
</Style>

<Style Selector="controls|ToolbarGroup Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E0E0E0" />
</Style>

<Style Selector="controls|ToolbarGroup Separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="#CCCCCC" />
    <Setter Property="Margin" Value="6,0" />
</Style>

<Style Selector="controls|ToolbarGroup > ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>

</Styles >

