<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Controls">

  <Styles.Resources>
  <ControlTheme x:Key="{x:Type controls:Toolbar}" TargetType="controls:Toolbar">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="#F5F5F5" />
    <Setter Property="BorderBrush" Value="#F5F5F5" />
    <Setter Property="MinHeight" Value="32" /> 
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="0,0,0,1">
          <ItemsPresenter Name="PART_ItemsPresenter" 
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>
  </Styles.Resources>

  <Style Selector="controls|Toolbar Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="controls|Toolbar Separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="#CCCCCC" />
    <Setter Property="Margin" Value="6,0" />
  </Style>

  <Style Selector="controls|Toolbar Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E0E0E0" />
  </Style>

</Styles>
