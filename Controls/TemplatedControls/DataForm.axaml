<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Controls"
                    xmlns:models="using:Controls.Models"
                    xmlns:converters="using:Controls.Converters"
                    xmlns:selectors="using:Controls.Selectors"
                    x:CompileBindings="False">

    <selectors:EditorTemplateSelector x:Key="EditorTemplateSelector" />
    <converters:BoolToGlyphConverter x:Key="BoolToGlyphConverter" />
    <converters:BoolToCursorConverter x:Key="BoolToCursorConverter" />
    <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    <converters:NotEqualConverter x:Key="NotEqualConverter" />

    <selectors:RowTemplateSelector x:Key="RowTemplateSelector">
        <selectors:RowTemplateSelector.SingleFieldTemplate>
            <DataTemplate DataType="models:FormRowModel">
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:FormFieldModel">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch">
                                <Grid Margin="{Binding FieldMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Classes="DataFormFieldLabel"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               FontSize="{Binding LabelFontSize, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               FontWeight="{Binding LabelFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               Foreground="{Binding LabelForeground, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               Margin="0,0,16,0"
                                               IsVisible="{Binding ShowLabel}" />

                                    <ContentControl Grid.Column="{Binding EditorColumn}"
                                                    Grid.ColumnSpan="{Binding EditorColumnSpan}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource EditorTemplateSelector}"
                                                    HorizontalAlignment="Stretch" 
                                                    VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="2"
                                               Classes="DataFormErrorIcon"
                                               Text="⚠️"
                                               Foreground="Red"
                                               IsVisible="{Binding ValidationError, Converter={x:Static converters:NotEmptyConverter.Instance}}"
                                               Margin="8,0,0,0"
                                               ToolTip.Tip="{Binding ValidationError}"
                                               ToolTip.IsOpen="{Binding ValidationError, Converter={x:Static converters:NotEmptyConverter.Instance}}"/>
                                </Grid>
                            </ScrollViewer>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </selectors:RowTemplateSelector.SingleFieldTemplate>

        <selectors:RowTemplateSelector.MultiFieldTemplate>
            <DataTemplate DataType="models:FormRowModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Classes="DataFormFieldLabel"
                               Text="{Binding Fields[0].DisplayName}"
                               VerticalAlignment="Center"
                               FontSize="{Binding LabelFontSize, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                               FontWeight="{Binding LabelFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                               Foreground="{Binding LabelForeground, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                               Margin="0,0,16,0"
                               IsVisible="{Binding Fields[0].ShowLabel}" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Fields.Count}" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:FormFieldModel">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalAlignment="Stretch">
                                    <Grid Margin="{Binding FieldMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                               Classes="DataFormFieldLabel"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               FontSize="{Binding LabelFontSize, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               FontWeight="{Binding LabelFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               Foreground="{Binding LabelForeground, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                               Margin="0,0,16,0"
                                               IsVisible="{Binding ShowLabelInRow}" />

                                        <ContentControl Grid.Column="1"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource EditorTemplateSelector}"
                                                        HorizontalAlignment="Stretch" 
                                                        VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Classes="DataFormErrorIcon"
                                                   Text="⚠️"
                                                   Foreground="Red"
                                                   IsVisible="{Binding ValidationError, Converter={x:Static converters:NotEmptyConverter.Instance}}"
                                                   Margin="8,0,0,0"
                                                   ToolTip.Tip="{Binding ValidationError}"
                                                   ToolTip.IsOpen="{Binding ValidationError, Converter={x:Static converters:NotEmptyConverter.Instance}}"/>
                                    </Grid>
                                </ScrollViewer>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
        </selectors:RowTemplateSelector.MultiFieldTemplate>
    </selectors:RowTemplateSelector>

    <ControlTheme x:Key="{x:Type controls:DataForm}" TargetType="controls:DataForm">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="8" Margin="0,0,0,8"
                                IsVisible="{TemplateBinding ButtonPanelPlacement,
                                    Converter={StaticResource EnumToBoolConverter},
                                    ConverterParameter={x:Static controls:ButtonPanelPlacement.Top}}">
                        <Button Classes="DataFormSaveButton" Content="Сохранить" Command="{Binding CommitChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                        <Button Classes="DataFormCancelButton" Content="Отмена" Command="{Binding CancelChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <DockPanel>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Spacing="8" Margin="0,0,0,8"
                                        IsVisible="{TemplateBinding ButtonPanelPlacement,
                                            Converter={StaticResource EnumToBoolConverter},
                                            ConverterParameter={x:Static controls:ButtonPanelPlacement.InsideTop}}">
                                <Button Classes="DataFormSaveButton" Content="Сохранить" Command="{Binding CommitChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                                <Button Classes="DataFormCancelButton" Content="Отмена" Command="{Binding CancelChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Spacing="8" Margin="0,8,0,0"
                                        IsVisible="{TemplateBinding ButtonPanelPlacement,
                                            Converter={StaticResource EnumToBoolConverter},
                                            ConverterParameter={x:Static controls:ButtonPanelPlacement.InsideBottom}}">
                                <Button Classes="DataFormSaveButton" Content="Сохранить" Command="{Binding CommitChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                                <Button Classes="DataFormCancelButton" Content="Отмена" Command="{Binding CancelChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Sections, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:FormSectionModel">
                                        <StackPanel Margin="0,0,0,12">

                                            <Button Classes="DataFormSectionHeader"
                                                    Command="{Binding ToggleCommand}"
                                                    IsEnabled="{Binding CanCollapse}"
                                                    Cursor="{Binding CanCollapse, Converter={StaticResource BoolToCursorConverter}}"
                                                    Background="Transparent" BorderThickness="0" Padding="8,4"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                    <Style Selector="Button:disabled /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                    <Style Selector="Button:disabled">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </Style>
                                                </Button.Styles>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolToGlyphConverter}}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,8,0" DockPanel.Dock="Left"
                                                               IsVisible="{Binding CanCollapse}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="{Binding CategoryHeaderFontSize, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                                               FontWeight="{Binding CategoryHeaderFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                                               Foreground="{Binding CategoryHeaderForeground, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:DataForm}}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>

                                            <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:FormRowModel">
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource RowTemplateSelector}" 
                                                                        VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Rectangle Classes="DataFormSectionSeparator" Height="1" Fill="LightGray" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="8" Margin="0,8,0,0"
                                IsVisible="{TemplateBinding ButtonPanelPlacement,
                                    Converter={StaticResource EnumToBoolConverter},
                                    ConverterParameter={x:Static controls:ButtonPanelPlacement.Bottom}}">
                        <Button Classes="DataFormSaveButton" Content="Сохранить" Command="{Binding CommitChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                        <Button Classes="DataFormCancelButton" Content="Отмена" Command="{Binding CancelChangesCommand, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding HasChanges}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
